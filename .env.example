# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres (used by docker-compose)
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat
POSTGRES_PORT=5432

# Consumed by Prisma and the API server
DATABASE_URL="postgresql://chat:chat@localhost:5432/chat?schema=public"

# API server
PORT=4000
NODE_ENV=development

# Signs agent and admin session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------------------
# Seed-only credentials. Every account has its own scrypt-hashed password;
# these values are what `pnpm db:seed` assigns to the demo accounts. They are
# never read by the running server.
# ---------------------------------------------------------------------------
SEED_AGENT_PASSWORD=
SEED_ADMIN_EMAIL=admin@acme.example
SEED_ADMIN_PASSWORD=

# Browser origins allowed to call the API (comma separated)
# Web Push. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUBLIC_CHAT_URL=http://localhost:3002/chat

# Allowed browser origins. `*` lets the widget run on any website; admin and
# sign-in routes stay limited to the listed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# ---------------------------------------------------------------------------
# MinIO (S3-compatible storage for chat media, started by docker-compose)
# ---------------------------------------------------------------------------
MINIO_ACCESS_KEY=chatminio
MINIO_SECRET_KEY=change-me-to-a-long-random-string
# Where the API server reaches MinIO
MINIO_ENDPOINT=http://localhost:9100
# Where browsers reach MinIO (uploads go straight there); same as above locally
MINIO_PUBLIC_URL=http://localhost:9100
MINIO_BUCKET=chat-media
MINIO_REGION=us-east-1
# Host ports for the compose MinIO (9000/9001 are often taken by another MinIO)
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
