// Schema for the multi-branch chat MVP.
//
// Shape: Company -> Branch -> Agent -> Conversation -> Message.
// Conversation load is deliberately NOT denormalised onto Agent; the routing
// query counts ACTIVE conversations so the number can never drift out of sync.
//
// Prisma 7 takes the connection URL from prisma.config.ts (CLI) and from the
// driver adapter passed to PrismaClient (runtime), not from this file.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

enum SenderType {
  VISITOR
  AGENT
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  SEPARATED
  WIDOWED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
  admins   Admin[]
  leads    Lead[]
  labels   Label[]
}

/// Company-level operator. Deliberately a separate table from Agent: an admin
/// has no branch, no availability and no conversations, and authenticates
/// through its own endpoint.
model Admin {
  id           String   @id @default(cuid())
  companyId    String
  /// Null for a company admin, who sees every branch. Set for a branch admin,
  /// whose every read and write is confined to that one branch.
  branchId     String?
  name         String
  email        String   @unique
  passwordHash String
  /// Soft delete. An inactive admin cannot sign in, and any session they still
  /// hold stops working on its next request.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Cascade, not SetNull: nulling the branch would silently promote a branch
  /// admin to company admin. Branches are only ever soft-deleted anyway.
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Messages this admin sent in an agent's place.
  sentMessages Message[]

  @@index([companyId])
  @@index([branchId])
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  /// Where a chat goes when nothing named a branch: no agent link, no branch
  /// link, and the visitor is no longer asked. At most one per company, which
  /// a partial unique index enforces (see the `main_branch` migration) because
  /// Prisma cannot express `UNIQUE ... WHERE` on its own.
  isMain    Boolean  @default(false)
  /// Soft delete. An inactive branch is hidden from the widget and skipped by
  /// routing, but its history is preserved.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agents    Agent[]
  admins    Admin[]
  leads     Lead[]
  enquiries Enquiry[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model Agent {
  id           String   @id @default(cuid())
  branchId     String
  name         String
  email        String   @unique
  passwordHash String
  /// Profile photo in the media bucket. Null shows generated initials instead.
  avatarKey    String?
  isOnline     Boolean  @default(false)
  /// Soft delete. An inactive agent cannot sign in and is never routed to.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  // Routing locks and then scans the routable agents of one branch.
  pushSubscriptions PushSubscription[]

  @@index([branchId, isOnline, isActive])
}

/// The person on the other end of the chat. Identified by the id the widget
/// keeps in localStorage, with the contact details they give in the pre-chat
/// form. Kept separate from Conversation so a returning visitor has one set of
/// details rather than a copy per chat.
/// Everyone who has ever submitted the pre-chat form, deduplicated by phone.
///
/// Deliberately separate from Visitor: a Visitor is one browser (its id is the
/// value in localStorage, and conversations are owned by it), whereas a Lead is
/// a person, who may reach us from several browsers or devices over time.
/// Recorded whether or not an agent was free, so the enquiries nobody answered
/// are exactly the ones that can be followed up.
model Lead {
  id            String         @id @default(cuid())
  companyId     String
  name          String
  /// As the visitor typed it, which is what the admin dials.
  phone         String
  /// The same number reduced to digits with a country code, which is what
  /// actually identifies the person. `+92 300 1234567` and `03001234567` are
  /// one lead, not two.
  phoneKey      String
  /// Null on leads recorded before the pre-chat form asked for these.
  maritalStatus MaritalStatus?
  city          String?
  /// Branch chosen most recently. Kept nullable so removing a branch does not
  /// destroy the lead.
  branchId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// One row per time they got in touch. Counts are derived from these rather
  /// than denormalised onto the lead, so they cannot drift.
  enquiries Enquiry[]

  @@unique([companyId, phoneKey])
  @@index([companyId, updatedAt])
  @@index([companyId, city])
}

/// A single approach from a lead: one submission of the pre-chat form.
///
/// Keeping every attempt, rather than only a counter on Lead, is what makes the
/// history readable over time — when someone got in touch, which branch they
/// wanted, and whether anyone was there to answer.
model Enquiry {
  id             String   @id @default(cuid())
  leadId         String
  branchId       String?
  /// The chat that opened, when one did. Null for unanswered enquiries.
  conversationId String?
  /// False when nobody in that branch was online for this attempt.
  answered       Boolean
  createdAt      DateTime @default(now())

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([branchId, createdAt])
  @@index([answered, createdAt])
}

/// One browser. Its id is the value the widget keeps in localStorage.
///
/// A person is not a browser, though, which is why `phoneKey` is here: the
/// widget finds someone's chats by the number they type, so two browsers
/// belonging to the same person share a key and reach the same conversations.
/// It is deliberately not unique — a second device is a second row.
model Visitor {
  id            String         @id
  name          String
  phone         String
  /// The number reduced to digits with a country code, exactly as `Lead` does
  /// it. This is the identity a conversation is guarded by, so a visitor whose
  /// number holds no digits at all is keyed by their own id instead of sharing
  /// an "empty" identity with every other such browser.
  phoneKey      String
  /// What the team files this person under — "Umar -M1- 8344- LHR" — as
  /// opposed to the name they gave us, which stays as the record of what they
  /// said. Set by an agent, shared with the rest of the team, and never sent
  /// to the visitor it describes. Written to every row sharing a phoneKey,
  /// because it describes the person rather than one of their browsers.
  displayName   String?
  /// Null on visitors recorded before the pre-chat form asked for these.
  maritalStatus MaritalStatus?
  city          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  conversations Conversation[]

  pushSubscriptions PushSubscription[]

  @@index([phone])
  @@index([phoneKey])
}

/// A mark an agent or admin puts on a conversation: "Follow up", "Sold".
/// Company-wide and admin-managed, so the same idea is spelled one way and can
/// actually be filtered on.
model Label {
  id        String   @id @default(cuid())
  companyId String
  name      String
  /// A token from LABEL_COLORS in @repo/types, not free hex, so every chip
  /// stays legible in both themes.
  color     String   @default("grey")
  /// "Initiated", given to every new conversation. Renameable and
  /// recolourable, but not deletable — chat creation depends on it existing.
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations ConversationLabel[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// Which labels are on which conversation. A chat can carry several at once.
model ConversationLabel {
  conversationId String
  labelId        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([labelId])
}

model Conversation {
  id        String             @id @default(cuid())
  agentId   String
  visitorId String
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  closedAt  DateTime?

  agent     Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  visitor   Visitor             @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  messages  Message[]
  enquiries Enquiry[]
  labels    ConversationLabel[]

  // Counting an agent's live load, and listing their inbox.
  @@index([agentId, status])
  // Letting a returning visitor resume after a refresh.
  @@index([visitorId, status])
}

/// One emoji reaction on a message. The unique index on (messageId,
/// senderType) is what makes reacting again replace the previous reaction
/// rather than pile up, matching how WhatsApp behaves.
model Reaction {
  id         String     @id @default(cuid())
  messageId  String
  senderType SenderType
  emoji      String
  createdAt  DateTime   @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, senderType])
}

/// One browser that agreed to be notified, as the push service addressed it.
/// `visitorId` is set for the hosted chat page and `agentId` for the
/// dashboard; exactly one of them is filled in.
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  visitorId  String?
  agentId    String?
  createdAt  DateTime @default(now())
  /// Touched on every resubscribe, so dead browsers can be swept up later.
  lastSeenAt DateTime @default(now())

  visitor Visitor? @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  agent   Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([agentId])
}

model Message {
  id             String     @id @default(cuid())
  conversationId String
  senderType     SenderType
  content        String     @db.Text
  /// Idempotency key generated by the sender before the first attempt. A queued
  /// message that is retried after a dropped connection carries the same key, so
  /// re-delivery returns the stored row instead of writing a duplicate.
  /// Null for messages sent by clients that do not queue.
  clientId       String?    @unique
  createdAt      DateTime   @default(now())
  /// When the other side's app first had it: they were connected to the chat
  /// when it was sent, or connected later. The grey double tick.
  deliveredAt    DateTime?
  /// When the other side had the chat open on screen. The blue double tick.
  readAt         DateTime?
  /// The message this one replies to, quoted above it. Always in the same
  /// conversation; null for an ordinary message.
  replyToId      String?
  /// Set when an admin stepped in and sent this in the agent's place. The
  /// message still goes out as `AGENT` — the visitor sees the agent they have
  /// been talking to — and this is the record of who actually typed it.
  /// Never serialised to a visitor.
  sentByAdminId  String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Media sent with the message. `content` is then an optional caption.
  attachment   Attachment?
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  /// SetNull, not Cascade: removing an admin must not delete the messages they
  /// sent in an agent's place, only the record of who typed them.
  sentByAdmin  Admin?       @relation(fields: [sentByAdminId], references: [id], onDelete: SetNull)
  /// Replies quoting this message. Kept so deleting it clears their quote.
  replies      Message[]    @relation("MessageReplies")
  /// Emoji reactions, at most one per side.
  reactions    Reaction[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
  @@index([sentByAdminId])
}

enum AttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  /// Recorded in the chat, played back as a voice-note bubble.
  VOICE
  /// A document — PDF, spreadsheet, archive. Never rendered in the page: it is
  /// handed over as a download, which is both what the reader wants and what
  /// keeps a file that is secretly markup from running anywhere.
  FILE
}

/// A file in object storage, belonging to exactly one message. The bytes live in
/// MinIO under `key`; nothing here is served directly, clients get signed URLs.
model Attachment {
  id         String         @id @default(cuid())
  messageId  String         @unique
  /// Object key in the media bucket. Unique, so one upload backs one message.
  key        String         @unique
  kind       AttachmentKind
  mimeType   String
  fileName   String
  /// Bytes, as verified against storage when the message was sent.
  size       Int
  /// Voice notes and audio, when the client knew the length.
  durationMs Int?
  /// Loudness bars (0-100) captured while recording, drawn as the voice-note
  /// waveform. Empty for uploaded files.
  waveform   Int[]          @default([])
  createdAt  DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}
