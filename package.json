{
  "name": "multi-branch-chat-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:studio": "pnpm --filter @repo/db studio",
    "db:reset": "pnpm --filter @repo/db reset",
    "check": "pnpm --filter @repo/server check:routing && pnpm --filter @repo/server check:flow && pnpm --filter @repo/server check:realtime && pnpm --filter @repo/server check:admin && pnpm db:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2"
  }
}
