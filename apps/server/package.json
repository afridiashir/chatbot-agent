{
  "name": "@repo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .turbo dist node_modules",
    "check:routing": "tsx --env-file-if-exists=../../.env scripts/check-routing.ts",
    "check:realtime": "tsx --env-file-if-exists=../../.env scripts/check-realtime.ts",
    "check:flow": "tsx --env-file-if-exists=../../.env scripts/check-flow.ts",
    "check:admin": "tsx --env-file-if-exists=../../.env scripts/check-admin.ts"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/validation": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "socket.io-client": "^4.8.3"
  }
}
