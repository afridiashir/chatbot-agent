# ---------------------------------------------------------------------------
# Production settings. deploy/setup-server.sh writes the real file to
# /opt/chat/.env on the server with random secrets; this is the reference.
# Never commit the real file.
# ---------------------------------------------------------------------------

# Public addresses. Point each domain's DNS A record at the server's IP first.
API_DOMAIN=api.example.com       # API, live chat and https://API_DOMAIN/widget.js
APP_DOMAIN=app.example.com       # agent inbox and admin dashboard
MEDIA_DOMAIN=media.example.com   # chat photos, videos and voice notes
PUBLIC_SCHEME=https

# Client websites that embed the widget, comma separated, with scheme and no
# trailing slash: https://client-one.com,https://www.client-two.com
# A single * lets the widget run on any website, without listing each one. The
# dashboard, sign-in and admin endpoints stay limited to APP_DOMAIN either way.
EXTRA_CORS_ORIGINS=

# Database (internal to the server, never exposed publicly)
POSTGRES_USER=chat
POSTGRES_DB=chat
POSTGRES_PASSWORD=change-me-hex-only

# Session signing key: openssl rand -hex 32
JWT_SECRET=change-me

# Media storage (MinIO)
MINIO_ACCESS_KEY=chatminio
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=chat-media
